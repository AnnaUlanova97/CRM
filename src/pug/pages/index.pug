extends ../templates/__default

block vars
  -
      var params = {
          pageType: 'home',
          pageTitle: 'CRM'
      }
    
block content
    main.main.container.clients
        h1.clients__title Клиенты
        div.clients__content
            div.clients__filters 
                div.clients__table
                    div.clients__headline ID
                        button.clients__arrow
                                +svg-icon('arrow_downward', 'clients__icon')
                    div.clients__headline Фамилия Имя Отчество 
                        button.clients__arrow--az
                                +svg-icon('arrow-az', 'clients__icon--az')
                    div.clients__headline.clients__headline--max Дата и время создания
                        button.clients__arrow.clients__arrow_date
                                +svg-icon('arrow_downward', 'clients__icon')
                    div.clients__headline.clients__headline--max Последние изменения
                        button.clients__arrow.clients__arrow_changes
                                +svg-icon('arrow_downward', 'clients__icon')
                    div.clients__headline Контакты
                    div.clients__headline Действия
                div.clients__wrap 
                    ul.clients__inner.clients__table
                        li.clients__item  111112
                        li.clients__item Скворцов Денис Юрьевич
                        li.clients__item 21.02.2021 
                            span.clients__time 12:41
                        li.clients__item 21.02.2021 
                            span.clients__time 12:41
                        li.clients__item
                            button
                                +svg-icon('vk', 'table-icon')
                            button 
                                +svg-icon('mail', 'table-icon')
                            button 
                                +svg-icon('fb', 'table-icon')
                            button 
                                +svg-icon('phone', 'table-icon')
                            button 
                                +svg-icon('ellipse', 'table-icon_ellipse')
                        li.clients__item
                            button.clients__btn.clients__btn--change Изменить
                                +svg-icon('actions', 'table-icon')
                            button.clients__btn.clients__btn--cancel Удалить
                                +svg-icon('cancel', 'table-icon_cancel')
                //- +svg-icon('frame', 'clients__frame')
            button.clients__add
                +svg-icon('btn-add', 'clients__svg')
                span Добавить клиента
            
                
        
    
