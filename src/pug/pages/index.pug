extends ../templates/__default

block vars
  -
      var params = {
          pageType: 'home',
          pageTitle: 'CRM'
      }
    
block content
    main.main.container.clients
        h1.clients__title Клиенты
        div.clients__content
            div.clients__filters 
                div.clients__table
                    button.clients__headline ID
                        +svg-icon('arrow_downward', 'clients__icon')
                    button.clients__headline Фамилия Имя Отчество 
                        +svg-icon('arrow-az', 'clients__icon--az')
                    button.clients__headline.clients__headline--max Дата и время создания
                        +svg-icon('arrow_downward', 'clients__icon')
                    button.clients__headline.clients__headline--max Последние изменения
                        +svg-icon('arrow_downward', 'clients__icon')
                    button.clients__headline Контакты
                    button.clients__headline Действия
                div.clients__wrap 
                    ul.clients__inner.clients__table
                        li.clients__item  111112
                        li.clients__item Скворцов Денис Юрьевич
                        li.clients__item 21.02.2021 
                            span.clients__time 12:41
                        li.clients__item 21.02.2021 
                            span.clients__time 12:41
                        li.clients__item
                            button
                                +svg-icon('vk', 'table-icon')
                            button 
                                +svg-icon('mail', 'table-icon')
                            button 
                                +svg-icon('fb', 'table-icon')
                            button 
                                +svg-icon('phone', 'table-icon')
                            button 
                                +svg-icon('ellipse', 'table-icon_ellipse')
                        li.clients__item
                            button.clients__btn.clients__btn--change Изменить
                                +svg-icon('actions', 'table-icon')
                            button.clients__btn.clients__btn--cancel Удалить
                                +svg-icon('cancel', 'table-icon_cancel')
                //- +svg-icon('frame', 'clients__frame')
            button.clients__add.js-btn-modal-open(data-modal='modal-open')
                +svg-icon('btn-add', 'clients__svg')
                span Добавить клиента
        div.modal#modal-open
            div.modal__box
                div.modal__content
                    h2.modal__title Изменить данные
                    span.modal__id ID: 123458
                    button.modal__close.js-modal-close
                        +svg-icon('close-form', 'close-icon')
                    form(action="").modal__form
                        label.modal__lastname Фамилия
                            input(type="text" required)
                        label.modal__name Имя
                            input(type="text" required)
                        label Отчество
                            input(type="text")
                div.modal__add.modal__add--open
                    div.modal__contact
                        button.modal__contacts.js-btn-modal-open(data-modal='modal-select') Телефон
                            +svg-icon('arrow_back', 'modal-arrow')
                        input(type="text" required placeholder='Введите данные контакта').modal__input
                        div.modal__select#modal-select
                            button Доп. телефон
                            button Email
                            button Vk
                            button Facebook
                    button.modal__btn Добавить контакт
                        +svg-icon('add_circle_outline', 'add-icon')
                div.modal__actions
                    button.btn__save Сохранить
                    button.btn__delete Удалить клиента

            
                
       
    
