extends ../templates/__default

block vars
  -
      var params = {
          pageType: 'home',
          pageTitle: 'CRM'
      }
    
block content
    main.main.container.clients
        h1.clients__title Клиенты
        div.clients__wrap
            div.clients__table
                div.clients__filters
                    button.clients__headline.js-sort-id ID
                        +svg-icon('arrow_downward', 'clients__icon js-icon-id')
                    button.clients__headline.js-sort-name Фамилия Имя Отчество 
                        +svg-icon('arrow_downward', 'clients__icon js-icon-name')
                        span.clients__icon--text A-Я
                        //- +svg-icon('arrow-az', 'icon--az')
                    button.clients__headline.clients__headline--max.js-sort-save Дата и время создания
                        +svg-icon('arrow_downward', 'clients__icon js-icon-save')
                    button.clients__headline.clients__headline--max.js-sort-change Последние изменения
                        +svg-icon('arrow_downward', 'clients__icon js-icon-change')
                    p.clients__headline Контакты
                    p.clients__headline Действия
                div.clients__content

            button.btn-secondary.js-btn-modal-toggle(data-modal='client-add')
                +svg-icon('btn-add', 'clients__svg')
                span Добавить клиента
    +modal


   
            
                
       
    
