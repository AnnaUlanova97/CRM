mixin add-client
    div.add-client#add-client
        div.add-client__box
            div.add-client__content
                button(data-modal="modal-add").modal-wrap__close.js-btn-modal-toggle
                    +svg-icon('close-form', 'close-icon')
                h2.add-client__title Добавить клиента
                span.add-client__id
                form(action="").add-client__form
                    div.input.input--required
                        p Фамилия
                        input(type="text" required).input__surname
                    div.input.input--required 
                        p Имя
                        input(type="text" required).input__name
                    div.input
                        p Отчество
                        input(type="text").input__lastname
                div.add-client__add-contact
                    div.add-client__inner.js-modal-select
                    button.add-client__btn.js-modal-btn Добавить контакт
                        +svg-icon('add_circle_outline', 'add-icon')
                div.add-client__actions
                    button.btn__save.js-btn-save Сохранить
                    button.btn__delete Удалить клиента








