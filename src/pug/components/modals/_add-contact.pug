mixin contact 
    div.contact
        div.contact__wrap
            div.contact__dropdown
                button.contact__btn Телефон
                +svg-icon('arrow_back', 'modal-arrow')
            div.contact__select
                button.js-contact-btn Доп. телефон
                button.js-contact-btn Email
                button.js-contact-btn Vk
                button.js-contact-btn Facebook
        input(type="tel" maxlength="16" required placeholder='Введите данные контакта').contact__input.js-contact-input
        div.contact__delete


